@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
}

<!doctype html>
<html lang="sv">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Name</title>
    <link rel="stylesheet" href="/css/site.css">

</head>

<body>
    <header>
        <nav arial-label="Huvudmeny">
            <ul>
                @foreach (var projekt in Model.Children())
                {
                    <li>
                        <a href="@projekt.Url()">@projekt.Name</a>
                    </li>
                }
            </ul>
        </nav>
    </header>

    <main>
        <h1> @Model.Name </h1>
        <p> Välkommen till Kodhuset AB! </P>
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year Kodhuset AB</p>
    </footer>
</body>

</html>