@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
}

<!doctype html>
<html lang="sv">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>

<body>

    <header>
        <nav aria-label="Huvudmeny">
            <ul>
                @{
                    var home = Model.Root();
                    var navigationPages = home.Children().ToList();
                }
                <li><a href="@home.Url()">Kodhuset AB</a></li>
                @foreach (var label in new[] { "Tjänster", "Projekt", "Om oss", "Kontakt" })
                {
                    var navigationPage = navigationPages.FirstOrDefault(p => string.Equals(p.Name, label, StringComparison.OrdinalIgnoreCase));
                    if (navigationPage != null)
                    {
                        <li><a href="@navigationPage.Url()">@navigationPage.Name</a></li>
                    }
                }
            </ul>
        </nav>
    </header>

    <main>
        <h1>@Model.Name</h1>

        <section class="kort">
            @Model.Value("beskrivning")

            <p>
                <strong>Kund:</strong>
                @Model.Value("kund")
            </p>

            <p>
                <strong>Teknik:</strong>
                @string.Join(", ", Model.Value<IEnumerable<string>>("teknik") ?? new string[0])
            </p>
        </section>

        <a href="/kontakt/" class="knapp">Kontakta oss</a>

    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year Kodhuset AB</p>
    </footer>

</body>
</html>
